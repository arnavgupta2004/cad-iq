GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated browser origins allowed to call the API (include your Vercel URL).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Optional overrides for hosted environments with ephemeral disks
# UPLOAD_DIR=/tmp/cadiq-uploads
# CHROMA_DB_PATH=/tmp/cadiq-chroma
